# --- Base de données (fournie automatiquement par l'add-on PostgreSQL Scalingo) ---
DATABASE_URL=postgres://user:password@host:port/dbname

# --- Session / sécurité ---
SESSION_COOKIE_NAME=adelphe_session
# Nombre de jours de validité d'une session avant reconnexion obligatoire
SESSION_DURATION_DAYS=30

# --- OVHcloud Object Storage (S3-compatible) ---
# Project Public Cloud > Object Storage > créer un conteneur (bucket), puis
# Users & Roles > créer un utilisateur S3 pour obtenir les clés.
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_REGION=gra
OVH_S3_BUCKET=adelphe-fichiers
OVH_S3_ACCESS_KEY=xxxxxxxxxxxxxxxx
OVH_S3_SECRET_KEY=xxxxxxxxxxxxxxxx
# URL publique de base pour construire les liens de fichiers (dépend de la
# région et du nom du conteneur, visible dans l'interface OVHcloud)
OVH_S3_PUBLIC_BASE_URL=https://adelphe-fichiers.s3.gra.io.cloud.ovh.net

# --- Brevo (e-mails transactionnels) ---
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=secretariat@adelphe.org
BREVO_SENDER_NAME=Adelphe

# --- Divers ---
NEXT_PUBLIC_SITE_URL=https://adelphe.org
# Clé que VOUS inventez (une longue phrase unique), utilisée une seule
# fois sur la page /setup pour créer le tout premier compte
# administrateur sans avoir besoin d'une console ou de la CLI.
SETUP_SECRET=changez-moi-avec-une-phrase-longue-et-unique
